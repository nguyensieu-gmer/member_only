<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Membership</title>

    <link rel="stylesheet" href="/styles.css" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    />
  </head>

  <body class="auth-page">
    <main class="auth-container membership-container">
      <a href="/" class="home-link">
        <i class="fa-solid fa-arrow-left"></i>
        Go home
      </a>

      <section class="auth-card membership-card">
        <% if (locals.member) { %>
          <div class="membership-icon success-icon">
            <i class="fa-solid fa-crown"></i>
          </div>

          <p class="eyebrow">YOU'RE PART OF THE COMMUNITY</p>
          <h1>Thank you for joining us!</h1>

          <p class="auth-description">
            Your membership is active. We're happy to have you with us.
          </p>

          <div class="membership-status">
            <i class="fa-solid fa-circle-check"></i>
            <span>Active membership</span>
          </div>

          <a href="/member-ship/cancel" class="cancel-membership">
            <i class="fa-solid fa-xmark"></i>
            Cancel membership
          </a>
        <% } else { %>
          <div class="membership-icon">
            <i class="fa-solid fa-key"></i>
          </div>

          <p class="eyebrow">UNLOCK MORE POSSIBILITIES</p>
          <h1>Become a member</h1>

          <p class="auth-description">
            Enter your membership key to join our community.
          </p>

          <form action="/member-ship" method="post" class="auth-form">
            <div class="form-group">
              <label for="key">Membership key</label>

              <div class="input-wrapper">
                <i class="fa-solid fa-key"></i>
                <input
                  type="text"
                  name="membership_key"
                  id="key"
                  placeholder="Enter your key"
                  autocomplete="off"
                  required
                />
              </div>
            </div>

            <button type="submit" class="auth-submit">
              Activate membership
              <i class="fa-solid fa-arrow-right"></i>
            </button>
          </form>
        <% } %>
      </section>

      <p class="page-note">A little extra for our community.</p>
    </main>
  </body>
</html>