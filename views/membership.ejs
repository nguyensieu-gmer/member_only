<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <a href="/">go home</a>
    <% if (locals.member){%> 
      <h1>Thank you for joining us</h1>
      <h1>You have membership right</h1>
      <a href="/member-ship/cancel">cancel membership</a>
    <%} else {%>
    <h1>Enter membership key</h1>
      <form action="/member-ship" method="post">
        <label for="key">key:</label>
        <input type="text" name="membership_key" id="key" />
        <button type="submit">submit</button>
      </form>
    <%}%>
  </body>
</html>
