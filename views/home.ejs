<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
  </head>
  <body>
    <% if (locals.username){%> 
      <span><%= username%></span> 
      <a href="log-out">log out</a>
    <%}%> 
    <h1>Home page</h1>
    <a href="/sign-up">sign up</a>
    <br />
    <a href="/log-in">log in</a>
    <br />
    <a href="/add-message">Add message</a>
    <br />
    <% if (locals.username){%> 
      <a href="/member-ship">membership</a>
    <%}%> 
    <% if(locals.messages){%>
        <ul>
            <% messages.forEach(message => {%>
              <li>
                <% if (locals.member || locals.admin){%>
                  <h3>username: <%= message.username%></h3>
                  <h3>gmail: <%= message.useremail%></h3>
                <%}%>
                <h4>title: <%= message.title%></h4>
                <p>message: <%= message.message%></p>
                 <% if (locals.member || locals.admin){%>
                  <p>Added: <%= new Date(message.added).toISOString().split("T")[0] %></p>
                <%}%>
                <% if (locals.admin){%>
                  <form action="/admin/remove-message/<%= message.messageid%>" method="post">
                    <button type="submit">Delete message</button>
                  </form>
                <%}%>
              </li>                
            <%})%>
        </ul>
    <%}%>
  </body>
</html>
